{
  "name": "food-outline-progress",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox progress tracker for food annotation tasks",
  "scripts": {
    "test": "node --test tests/lib.test.js",
    "lint": "npx --yes web-ext lint --source-dir . --ignore-files \"tests/**\" \"demo/**\" \"package.json\" \"package-lock.json\" \"README.md\" \".git/**\"",
    "start": "npx --yes web-ext run --source-dir . --start-url \"http://localhost:8000/demo/?frame=10\"",
    "build": "npx --yes web-ext build --source-dir . --artifacts-dir dist --overwrite-dest --ignore-files \"tests/**\" \"demo/**\" \"package.json\" \"package-lock.json\" \"README.md\" \".git/**\""
  }
}
