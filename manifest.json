{
  "manifest_version": 2,
  "name": "Food Outline Progress",
  "version": "0.1.1",
  "description": "Progress tracker and range helper for food annotation tasks.",
  "permissions": ["storage", "tabs", "activeTab", "<all_urls>"],
  "browser_action": {
    "default_title": "Food Outline Progress",
    "default_popup": "src/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/lib.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "food-outline-progress@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
